    z: 2,
  },
  {
    file: "cli",
    left: 90,
    dur: 12,
    delay: 7,
    s: 0.6,
    blur: 3.16,
    bright: 1.3,
    z: 0,
  },
  {
    file: "pok",
    left: 18,
    dur: 22,
    delay: 13,
    s: 0.84,
    blur: 3.99,
