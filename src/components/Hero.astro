    bright: 1.2,
    z: 1,
  },
  {
    file: "rai",
    left: 32,
    dur: 14,
    delay: 5,
    s: 0.96,
    blur: 3.16,
    bright: 1.3,
    z: 0,
  },
  {
    file: "tri",
    left: 42,
    dur: 20,
    delay: 12,
    s: 0.82,
    blur: 3.99,
    bright: 1.4,
    z: -1,
  },
  {
    file: "burger",
    left: 68,
    dur: 16,
    delay: 3,
    s: 0.5,
    blur: 1.5,
    bright: 1.1,
