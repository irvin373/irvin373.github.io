    z: 0,
  },
  {
    file: "gameboy",
    left: 28,
    dur: 20,
    delay: 6,
    s: 0.56,
    blur: 2.5,
    bright: 1.1,
    z: 2,
  },
  {
    file: "tori",
    left: 58,
    dur: 16,
    delay: 14,
    s: 0.6,
    blur: 2.33,
