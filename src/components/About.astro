---
const skills = [
  { name: 'React Native', img: '/assets/skills/react.png',       color: '#61DAFB' },
  { name: 'React',        img: '/assets/skills/react.png',       color: '#61DAFB' },
  { name: 'TypeScript',   img: '/assets/skills/typescript.png',  color: '#3178C6' },
  { name: 'JavaScript',   img: null,                             color: '#F7DF1E' },
  { name: 'Android',      img: null,                             color: '#3DDC84' },
  { name: 'Kotlin',       img: null,                             color: '#7F52FF' },
  { name: 'Python',       img: null,                             color: '#3776AB' },
  { name: 'Ruby',         img: null,                             color: '#CC342D' },
  { name: 'Figma',        img: null,                             color: '#F24E1E' },
  { name: 'Git',          img: '/assets/skills/github.png',      color: '#F05032' },
];

const interests = [
  { label: 'AI Models',        icon: 'brain-circuit',   desc: 'Cloud & local LLMs — Gemma, Claude, Gemini' },
  { label: 'XR Web',          icon: 'glasses',          desc: 'WebXR, immersive 3D browser experiences' },
  { label: 'Lottie / Motion', icon: 'sparkles',         desc: 'Expressive UI animations & micro-interactions' },
  { label: 'Video Games',     icon: 'gamepad-2',        desc: 'Avid gamer, game mechanics inspire my UX thinking' },
];

const certifications = [
  { title: 'Android Development', issuer: 'Meta · Coursera', icon: 'award' },
  { title: 'React Native',        issuer: 'Meta · Coursera', icon: 'award' },
  { title: 'GDG Organizer',       issuer: 'Google Developer Group · Cochabamba', icon: 'users' },
];
---

<section id="about" class="section-wrapper">
  <div class="section-inner about-grid">

    <!-- ── Left column: bio ── -->
    <div class="about-bio">
      <p class="section-label">Who I am</p>
      <h2 class="section-title">About<br /><em>Me</em></h2>

      <div class="bio-text">
        <p>
          From <strong>Cochabamba, Bolivia</strong>, I'm a Senior Mobile &amp; Frontend Engineer
          with <strong>8+ years</strong> of experience shipping products used by millions —
          from fintech wallets and delivery platforms to enterprise mobile apps.
        </p>
        <p>
          My stack spans the full mobile spectrum: <strong>React Native</strong> for
          cross-platform reach, <strong>Android / Kotlin</strong> for native depth, and
          <strong>React + TypeScript</strong> on the web. I care deeply about performance,
          clean architecture, and UX that feels effortless.
        </p>
        <p>
          Currently at <strong>Plata Fintech (US)</strong>, I'm embedding AI coding tools
          like Claude Code into our engineering workflow — converting Linear tickets into
          structured spec prompts and reducing ticket-to-PR time by <strong>~30%</strong>.
          I'm fascinated by how AI is reshaping how we build software.
        </p>
        <p>
          I hold a degree in <strong>Informatics Engineering</strong> from UMSS, where my
          thesis achieved <strong>90% accuracy</strong> in classifying medicinal plants using
          deep learning. That curiosity for ML never left.
        </p>
      </div>

      <!-- Certs & GDG -->
      <div class="certs-row">
        {certifications.map(cert => (
          <div class="cert-card">
            <i data-lucide={cert.icon} class="cert-icon"></i>
            <div>
              <p class="cert-title">{cert.title}</p>
              <p class="cert-issuer">{cert.issuer}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- ── Right column: skills + interests ── -->
    <div class="about-right">
      <!-- Skills grid -->
      <div class="skills-header">
        <p class="section-label">Tech stack</p>
      </div>
      <div class="skills-grid">
        {skills.map(skill => (
          <div class="skill-pill">
            {skill.img
              ? <img src={skill.img} alt={skill.name} width="20" height="20" />
              : <span class="skill-dot" style={`background:${skill.color};`}></span>
            }
            <span>{skill.name}</span>
          </div>
        ))}
      </div>

      <!-- Languages -->
      <div class="lang-row">
        <div class="lang-chip">
          <span class="lang-flag">🇧🇴</span>
          <span class="lang-name">Spanish</span>
          <span class="lang-level">Native</span>
        </div>
        <div class="lang-chip">
          <span class="lang-flag">🇺🇸</span>
          <span class="lang-name">English</span>
          <span class="lang-level">B2</span>
        </div>
      </div>

      <!-- Interests -->
      <p class="section-label" style="margin-top:40px;">Interests</p>
      <div class="interests-grid">
        {interests.map(item => (
          <div class="interest-card">
            <i data-lucide={item.icon} class="interest-icon"></i>
            <p class="interest-label">{item.label}</p>
            <p class="interest-desc">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>

<style>
  /* ── Grid layout ── */
  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: start;
  }

  /* ── Bio text ── */
  .bio-text {
    display: flex;
    flex-direction: column;
    gap: 18px;
    margin-bottom: 40px;
    color: var(--text-muted);
    font-size: 16px;
    line-height: 1.75;
  }

  .bio-text strong {
    color: var(--text);
    font-weight: 600;
  }

  /* ── Certs ── */
  .certs-row {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .cert-card {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 16px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 10px;
    transition: border-color 0.25s;
  }

  .cert-card:hover {
    border-color: var(--border-bright);
  }

  .cert-icon {
    width: 18px;
    height: 18px;
    color: var(--accent);
    flex-shrink: 0;
  }

  .cert-title {
    font-size: 14px;
    font-weight: 600;
    color: var(--text);
  }

  .cert-issuer {
    font-size: 12px;
    color: var(--text-muted);
    margin-top: 2px;
  }

  /* ── Skills ── */
  .skills-header {
    margin-bottom: 16px;
  }

  .skills-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 24px;
  }

  .skill-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 50px;
    font-size: 13px;
    font-weight: 500;
    color: var(--text);
    transition: border-color 0.25s, background 0.25s, transform 0.2s;
    cursor: default;
  }

  .skill-pill:hover {
    border-color: var(--border-bright);
    background: var(--card-hover);
    transform: translateY(-2px);
  }

  .skill-pill img {
    border-radius: 3px;
    object-fit: contain;
  }

  .skill-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  /* ── Languages ── */
  .lang-row {
    display: flex;
    gap: 12px;
  }

  .lang-chip {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 8px;
    font-size: 13px;
  }

  .lang-flag { font-size: 16px; }

  .lang-name {
    color: var(--text);
    font-weight: 500;
  }

  .lang-level {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: var(--accent);
    background: rgba(232, 4, 175, 0.1);
    padding: 2px 6px;
    border-radius: 4px;
  }

  /* ── Interests ── */
  .interests-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-top: 16px;
  }

  .interest-card {
    padding: 16px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
    transition: border-color 0.25s, transform 0.25s;
  }

  .interest-card:hover {
    border-color: var(--border-bright);
    transform: translateY(-3px);
  }

  .interest-icon {
    width: 20px;
    height: 20px;
    color: var(--accent);
    margin-bottom: 8px;
  }

  .interest-label {
    font-size: 13px;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 4px;
  }

  .interest-desc {
    font-size: 11px;
    color: var(--text-muted);
    line-height: 1.5;
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }

  @media (max-width: 480px) {
    .interests-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
