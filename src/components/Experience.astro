---
const jobs = [
  {
    company:   'Plata Fintech',
    role:      'Mobile / Frontend Senior Software Engineer',
    period:    'Sep 2025 — Present',
    location:  'United States · Remote',
    logo:      '/assets/xp/plata-w.png',
    current:   true,
    bullets: [
      'Maintained code quality across React Native & React JS codebases by triaging and resolving bugs via Linear for a fintech platform.',
      'Implemented Wallet and WhatsApp Native integrations into a React Native fintech app serving 200+ users.',
      'Reduced ticket-to-PR time by ~30% by integrating AI coding tools (Claude Code, Antigravity) — converting Linear tickets into structured Spec prompts to guide code agents.',
    ],
    tags: ['React Native', 'React', 'TypeScript', 'AI Tooling', 'Linear'],
  },
  {
    company:   'Zubale',
    role:      'Mobile / Web Software Engineer',
    period:    'Oct 2024 — Aug 2025',
    location:  'Mexico · Remote',
    logo:      null,
    current:   false,
    bullets: [
      'Built React web control apps for delivery management and task assignment, serving 115 client stores and 300+ drivers across 7 countries.',
      'Engineered end-to-end product-picking and delivery flows with map integrations.',
      'Integrated deeplink routing and third-party APIs (calls, messaging, calendar) for seamless cross-app workflows.',
      'Maintained platform stability for 300+ active drivers across React and React Native codebases.',
    ],
    tags: ['React', 'React Native', 'Maps API', 'TypeScript', 'Jira'],
  },
  {
    company:   'Jalasoft',
    role:      'Mobile Software Engineer',
    period:    'Sep 2022 — Jan 2025',
    location:  'Cochabamba, Bolivia',
    logo:      null,
    current:   false,
    bullets: [
      'Delivered an employee time-tracking system adopted by 300 users, building check-in/check-out flows and management dashboards with Android, Kotlin & Jetpack Compose.',
      'Engineered a crypto wallet module with QR-based send/receive flows and real-time balance display for 200 users.',
      'Built a cross-platform onboarding system (exams, video classes via WebViews) used by 8 employees across React Native, Android and iOS.',
      'Mentored 8 engineers across internal onboarding and bootcamp programs.',
    ],
    tags: ['Android', 'Kotlin', 'Jetpack Compose', 'React Native', 'iOS'],
  },
  {
    company:   'Witco (Ex Monbuilding)',
    role:      'Mobile Software Engineer',
    period:    'Aug 2017 — Sep 2022',
    location:  'France · Remote',
    logo:      '/assets/xp/witco-w.png',
    current:   false,
    bullets: [
      'Delivered React Native mobile solutions for 20+ enterprise clients including a major bank, entertainment parks, and coworking networks — building native hardware integrations for iOS and Android.',
      'Reduced app bundle size by 20% and improved build performance by leading 3 major React Native version migrations over 5 years.',
      'Onboarded and mentored 4 engineers, tracking their technical growth milestones.',
    ],
    tags: ['React Native', 'iOS', 'Android', 'Native Modules', 'TypeScript'],
  },
  {
    company:   'Freelance',
    role:      'FullStack Software Engineer',
    period:    'Jan 2017 — Aug 2017',
    location:  'Cochabamba, Bolivia',
    logo:      null,
    current:   false,
    bullets: [
      'Built backend features for a Pharmacy management system using Ruby on Rails and Angular.',
      'Developed and iterated a grocery delivery app through multiple rebranding cycles.',
      'Automated web scraping pipelines with Ruby & JavaScript for ML training data collection.',
    ],
    tags: ['Ruby on Rails', 'Angular', 'JavaScript'],
  },
];

const gdg = {
  company:  'Google Developer Group Cochabamba',
  role:     'Organizer & Volunteer',
  period:   'Jul 2022 — Present',
  location: 'Cochabamba, Bolivia',
  logo:     '/assets/xp/gdg-w.png',
  bullets: [
    'Organized community tech events, growing local developer engagement in Cochabamba.',
    'Delivered workshops on Android development and TypeScript to the local tech community.',
  ],
};
---

<section id="experience" class="section-wrapper exp-section">
  <div class="section-inner">
    <p class="section-label">Where I've worked</p>
    <h2 class="section-title">Work <em>Experience</em></h2>

    <!-- Timeline -->
    <div class="timeline">
      {jobs.map((job, i) => (
        <div class={`timeline-item ${i % 2 === 0 ? 'left' : 'right'}`}>
          <div class="timeline-dot" class:list={[{ current: job.current }]}></div>
          <div class="timeline-card glass-card">
            <div class="card-header">
              <div class="card-meta">
                <div class="company-row">
                  {job.logo
                    ? <img src={job.logo} alt={job.company} class="company-logo" />
                    : <span class="company-initial">{job.company[0]}</span>
                  }
                  <div>
                    <h3 class="company-name">{job.company}</h3>
                    {job.current && <span class="badge-current">Current</span>}
                  </div>
                </div>
                <p class="job-role">{job.role}</p>
                <div class="job-info">
                  <span class="job-period">
                    <i data-lucide="calendar" style="width:13px;height:13px;"></i>
                    {job.period}
                  </span>
                  <span class="job-location">
                    <i data-lucide="map-pin" style="width:13px;height:13px;"></i>
                    {job.location}
                  </span>
                </div>
              </div>
            </div>

            <ul class="bullets">
              {job.bullets.map(b => (
                <li>
                  <span class="bullet-dot"></span>
                  {b}
                </li>
              ))}
            </ul>

            <div class="tags-row">
              {job.tags.map(t => (
                <span class="tag">{t}</span>
              ))}
            </div>
          </div>
        </div>
      ))}

      <!-- Center line -->
      <div class="timeline-line" aria-hidden="true"></div>
    </div>

    <!-- GDG Card (leadership) -->
    <div class="gdg-section">
      <p class="section-label">Community</p>
      <div class="glass-card gdg-card">
        <div class="gdg-inner">
          <img src={gdg.logo} alt="Google Developer Group" class="gdg-logo" />
          <div class="gdg-text">
            <h3 class="company-name">{gdg.company}</h3>
            <p class="job-role">{gdg.role}</p>
            <div class="job-info">
              <span class="job-period">
                <i data-lucide="calendar" style="width:13px;height:13px;"></i>
                {gdg.period}
              </span>
              <span class="job-location">
                <i data-lucide="map-pin" style="width:13px;height:13px;"></i>
                {gdg.location}
              </span>
            </div>
            <ul class="bullets" style="margin-top:16px;">
              {gdg.bullets.map(b => (
                <li>
                  <span class="bullet-dot"></span>
                  {b}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  .exp-section {
    border-top: 1px solid var(--border);
  }

  /* ── Timeline shell ── */
  .timeline {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 64px 1fr;
    gap: 0;
    margin-bottom: 80px;
  }

  /* Vertical center line */
  .timeline-line {
    grid-column: 2;
    grid-row: 1 / -1;
    width: 2px;
    background: linear-gradient(to bottom, transparent, var(--accent) 10%, var(--accent) 90%, transparent);
    margin: 0 auto;
    position: relative;
  }

  /* ── Timeline items ── */
  .timeline-item {
    position: relative;
    padding-bottom: 48px;
  }

  .timeline-item.left {
    grid-column: 1;
    padding-right: 40px;
    text-align: right;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }

  .timeline-item.right {
    grid-column: 3;
    padding-left: 40px;
    text-align: left;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  /* Dot on the center line */
  .timeline-dot {
    position: absolute;
    width: 14px;
    height: 14px;
    background: var(--bg);
    border: 2px solid var(--accent);
    border-radius: 50%;
    top: 28px;
    z-index: 2;
  }

  .timeline-item.left  .timeline-dot { right: -39px; }
  .timeline-item.right .timeline-dot { left: -39px; }

  .timeline-dot.current {
    background: var(--accent);
    box-shadow: 0 0 12px rgba(232, 4, 175, 0.6);
  }

  /* ── Card ── */
  .timeline-card {
    padding: 24px;
    width: 100%;
    max-width: 500px;
  }

  .card-header { margin-bottom: 16px; }

  .company-row {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 6px;
  }

  .timeline-item.right .company-row { flex-direction: row; }
  .timeline-item.left  .company-row { flex-direction: row-reverse; }

  .company-logo {
    height: 28px;
    width: auto;
    object-fit: contain;
    filter: brightness(0) invert(1);
    opacity: 0.85;
    flex-shrink: 0;
  }

  .company-initial {
    width: 36px;
    height: 36px;
    background: var(--accent);
    color: #fff;
    font-weight: 700;
    font-size: 16px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .company-name {
    font-size: 16px;
    font-weight: 700;
    color: var(--text-light);
  }

  .badge-current {
    display: inline-block;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--accent);
    background: rgba(232, 4, 175, 0.12);
    border: 1px solid rgba(232, 4, 175, 0.3);
    padding: 2px 7px;
    border-radius: 4px;
    margin-left: 8px;
    vertical-align: middle;
  }

  .job-role {
    font-size: 13px;
    font-weight: 500;
    color: var(--accent-green);
    margin-bottom: 8px;
  }

  .job-info {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    font-size: 12px;
    color: var(--text-muted);
  }

  .job-period,
  .job-location {
    display: flex;
    align-items: center;
    gap: 5px;
    font-family: 'JetBrains Mono', monospace;
  }

  /* ── Bullets ── */
  .bullets {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 16px;
  }

  .bullets li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 13.5px;
    color: var(--text-muted);
    line-height: 1.6;
    text-align: left;
  }

  .bullet-dot {
    width: 6px;
    height: 6px;
    background: var(--accent);
    border-radius: 50%;
    margin-top: 7px;
    flex-shrink: 0;
  }

  /* ── Tags ── */
  .tags-row {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
  }

  .tag {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    padding: 3px 9px;
    background: rgba(232, 4, 175, 0.08);
    border: 1px solid rgba(232, 4, 175, 0.2);
    border-radius: 4px;
    color: var(--accent);
  }

  /* ── GDG ── */
  .gdg-section { margin-top: 24px; }

  .gdg-card { padding: 28px 32px; }

  .gdg-inner {
    display: flex;
    align-items: flex-start;
    gap: 24px;
  }

  .gdg-logo {
    height: 40px;
    width: auto;
    object-fit: contain;
    filter: brightness(0) invert(1);
    opacity: 0.85;
    flex-shrink: 0;
    margin-top: 4px;
  }

  .gdg-text { flex: 1; }

  /* ── Responsive: collapse timeline to single column ── */
  @media (max-width: 900px) {
    .timeline {
      display: flex;
      flex-direction: column;
      gap: 24px;
    }

    .timeline-line { display: none; }

    .timeline-item.left,
    .timeline-item.right {
      padding: 0;
      text-align: left;
      align-items: stretch;
    }

    .timeline-dot { display: none; }

    .timeline-card { max-width: 100%; }

    .timeline-item.left .company-row { flex-direction: row; }

    .gdg-inner { flex-direction: column; gap: 16px; }
  }
</style>
